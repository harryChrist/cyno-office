# Configuração do Cyno.
#
# Como usar:  cp .env.example .env   e ajuste o que precisar.
# O `.env` fica fora do git e vale para `npm run dev`, `npm start`, pm2 e Docker.
# Uma variável definida no ambiente (linha de comando, pm2, Docker) vale sobre este arquivo.
# Depois de mudar: reinicie o app (pm2: `npm run pm2:restart`; Docker: `docker compose up -d`).

# ============================================================
#  O PRINCIPAL (já vem com os valores padrão; mude o que quiser)
# ============================================================

# Endereço e porta em que o Cyno abre no navegador.
# 0.0.0.0 = toda a rede local; 127.0.0.1 = só esta máquina.
WEB_HOST=0.0.0.0
WEB_PORT=5173

# Domínio(s) pelo qual você acessa o Cyno de fora (túnel Cloudflare, proxy reverso), separados
# por vírgula. Ex.: cyno.exemplo.com. Sem isto o app recusa o acesso por um domínio.
WEB_ALLOWED_HOSTS=

# Domínio(s) que o navegador dos agentes nunca abre, separados por vírgula. Ponha aqui o
# endereço público do próprio Cyno, para um agente não abrir o app por fora. A rede local já é bloqueada.
BROWSER_BLOCKED_HOSTS=

# Onde ficam os dados (workspaces, projetos, senha). Relativo à raiz do projeto. No Docker é sempre /data.
DATA_DIR=./data

# Fuso horário das datas do app e dos agentes.
TZ=America/Sao_Paulo

# Executáveis das CLIs dos agentes (precisam estar instaladas e logadas na sua assinatura).
CLAUDE_BIN=claude
AGY_BIN=agy

# Porta interna do server (só esta máquina a alcança; o site faz a ponte).
PORT=3001

# Detalhe do log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ============================================================
#  AVANÇADO (opcional; os valores comentados são os padrões)
# ============================================================
# Tire o "#" do começo da linha para mudar. Lidas em packages/server/src/config.ts.

# --- Acesso ---
# CYNO_AUTH=on                  # off = sem senha o app fica aberto. SÓ para desenvolvimento e testes; nunca num servidor exposto

# --- Server ---
# HOST=127.0.0.1                # endereço do server
# WS_HEARTBEAT_MS=30000         # intervalo do ping do WebSocket
# SYSTEM_LOG=1                  # atividade do servidor (DATA_DIR/activity: boot, batimento, alertas); 0 desliga
# SYSTEM_LOG_SAMPLE_MS=60000    # intervalo da amostra de memória e do batimento (0 desliga a amostra)
# RETENTION_AUTO=1              # limpeza automática do histórico (no boot e uma vez por dia); 0 desliga
# CONNECTORS_STDIO=0            # 1 libera conectores que rodam um comando local (só em rede confiável). É só o padrão: o dono liga/desliga em Configurações > Conectores locais e a escolha dele vale sobre este valor

# --- Modo simulado (SÓ testes/e2e; em produção deixe desligado: só agentes e Maestro reais) ---
# AGENT_RUNNER=mock             # liga o runner falso, o Maestro simulado e o motor "mock"; sem isto, nada simulado
# MOCK_MIN_MS=3000              # duração mínima de uma tarefa simulada
# MOCK_MAX_MS=8000              # duração máxima de uma tarefa simulada
# MOCK_APPROVAL_RATE=0.2        # chance (0..1) de pedir aprovação; "[aprovar]" no pedido sempre pede
# MOCK_SUBAGENT_RATE=0.4        # chance (0..1) de dividir um passo entre 2-3 subagentes
# DONE_LINGER_MS=5000           # tempo que o agente fica em "done" antes de voltar a "idle"
# APPROVAL_PARK_MS=120000       # quanto uma tarefa esperando você segura a vaga do agente (0 = solta na hora; com outra tarefa na fila, solta sempre)

# --- Agentes reais (terminais de CLI de assinatura; nunca API paga) ---
# CLAUDE_EFFORT=low             # esforço padrão dos agentes claude sem "effort" (low|medium|high|xhigh|max; none = o da CLI)
# CLAUDE_AUTOCOMPACT=auto       # --autocompact dos agentes claude (auto, none ou 100000-1000000 tokens)
# CLAUDE_CONFIG_DIR=            # pasta de config do Claude Code (conversas em <ela>/projects); padrão ~/.claude
# MAESTRO_TERMINAL=pty          # Maestro de Claude Code: pty (terminal interativo visível no painel) ou headless (claude -p)
# MAESTRO_REMOTE_CONTROL=1      # Remote Control do terminal do Maestro (app do Claude e claude.ai/code); 0 desliga
# MAESTRO_ROTATE_TOKENS=0       # renova a conversa do Maestro de CLI acima desse total de tokens com um resumo; 0 = nunca
# TERMINAL_IDLE_MS=900000       # ocioso por tanto tempo = processo parado (a próxima ordem retoma a sessão); 0 = nunca
# CYNO_IDLE_MS=                  # só para teste: ociosidade do Cyno antes de dormir (ms); vazio = Configurações > Cyno (padrão 10 min)
# TERMINAL_MAX_RETRIES=3        # quedas seguidas do processo antes de desistir
# OFFICE_MCP_URL=               # URL do MCP "office" que as CLIs usam; padrão http://127.0.0.1:<PORT>/mcp

# --- Uso e cotas da assinatura ---
# CLAUDE_USAGE_POLL_MS=180000       # consulta do uso da conta Claude (ms); 0 desliga
# ANTIGRAVITY_USAGE_POLL_MS=300000  # consulta da cota da conta Google no Antigravity (ms); 0 desliga

# --- Navegador compartilhado dos agentes (Chromium, perfil por workspace) ---
# BROWSER=1                         # 0 desliga o navegador
# BROWSER_IDLE_MS=600000            # sem uso por tanto tempo o Chromium fecha; 0 = nunca

# --- Só para teste ---
# ROUTINE_TICK_MS=600000            # de quanto em quanto tempo o vigia das rotinas confere (ms; mín. 1000; padrão 10 min)

# --- Web (Vite; lidas em packages/web/vite.config.ts) ---
# WEB_HTTPS=0                   # 1 serve HTTPS com certificado autoassinado (o ditado por voz precisa de contexto seguro)

# --- App de teste (npm run lab:up; lido em scripts/lab-up.mjs) ---
# LAB_SERVER_PORT=3101          # porta do server de teste
# LAB_WEB_PORT=5273             # porta do web de teste
# LAB_DATA_DIR=                 # pasta de dados do teste (padrão: temporária em /tmp, apagada ao sair)
# LAB_KEEP=0                    # 1 não apaga a pasta temporária ao sair
# LAB_BROWSER=0                 # lab:up: 1 liga o navegador dos agentes no app de teste
# LAB_CONNECTORS_STDIO=0        # lab:up: 1 libera conectores stdio no app de teste
# LAB_API_URL=                  # lab:setup: server para montar o Laboratório (padrão: http://127.0.0.1:<PORT>)
