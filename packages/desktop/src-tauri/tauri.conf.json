{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyno Office",
  "version": "0.2.0",
  "identifier": "app.cyno.office",
  "build": {
    "devUrl": "http://localhost:3067",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cyno Office",
        "url": "http://localhost:3067",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3067 http://127.0.0.1:3067; connect-src 'self' http://localhost:3067 ws://localhost:3067 http://127.0.0.1:3067 ws://127.0.0.1:3067; img-src 'self' data: blob: http://localhost:3067 http://127.0.0.1:3067; style-src 'self' 'unsafe-inline' http://localhost:3067 http://127.0.0.1:3067; script-src 'self' 'unsafe-inline' http://localhost:3067 http://127.0.0.1:3067; font-src 'self' data: http://localhost:3067 http://127.0.0.1:3067; media-src 'self' blob: http://localhost:3067 http://127.0.0.1:3067"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/server/**/*",
      "resources/web/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/harryChrist/cyno-office/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
